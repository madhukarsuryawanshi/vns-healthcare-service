<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="layout :: layout(${customer.patientName}, ~{::section})">
<section>
    <div class="topbar">
        <div>
            <p class="eyebrow" th:text="${customer.custCode}">CUS-1001</p>
            <h2 class="page-title" th:text="${customer.patientName}">Patient</h2>
            <p class="sub" th:text="'Family contact: ' + ${customer.fullName} + ' · ' + ${customer.mobileNo}">Contact</p>
        </div>
        <div class="actions">
            <a class="btn ghost" th:if="${canWriteCustomers and !customer.closed}" th:href="@{/customers/{id}/edit(id=${customer.id})}">Edit</a>
            <form th:if="${canWriteCustomers and !customer.closed}" th:action="@{/customers/{id}/close(id=${customer.id})}" method="post"
                  onsubmit="return confirm('Close this service? Charges will be calculated from the 1st of this month to today. Hold days are unpaid.');">
                <button class="btn coral" type="submit">Close Service</button>
            </form>
        </div>
    </div>

    <div class="info-banner" th:if="${customer.closed}">
        Service closed on
        <span th:text="${customer.serviceClosedDate != null} ? ${#temporals.format(customer.serviceClosedDate, 'dd MMM yyyy')} : '—'">date</span>
        <span th:if="${billFrom != null and billTo != null}">
            (billed
            <span th:text="${#temporals.format(billFrom, 'dd MMM')}">01 Sep</span>
            to
            <span th:text="${#temporals.format(billTo, 'dd MMM')}">12 Sep</span>)
        </span>.
        Billed amount:
        <strong th:text="${customer.billedAmount != null} ? ${#numbers.formatDecimal(customer.billedAmount, 1, 'COMMA', 2, 'POINT')} : '0.00'">0</strong>
        <form th:action="@{/customers/{id}/recalculate(id=${customer.id})}" method="post" style="display:inline;margin-left:12px">
            <button class="btn ghost" type="submit">Recalculate this month</button>
        </form>
    </div>

    <div class="grid-2">
        <div class="panel">
            <h3>Case details</h3>
            <dl class="dl">
                <dt>Address</dt>
                <dd th:text="${customer.address}">Address</dd>
                <dt>Gender</dt>
                <dd th:text="${customer.gender != null} ? ${customer.gender} : '—'">—</dd>
                <dt>Age</dt>
                <dd th:text="${customer.age}">70</dd>
                <dt>Service</dt>
                <dd th:text="${customer.serviceType == T(com.vns.healthcare.domain.ServiceType).HOURS_24} ? '24 hours' : '12 hours'">24 hours</dd>
                <dt>Monthly charges</dt>
                <dd th:text="${customer.charges != null} ? ${#numbers.formatDecimal(customer.charges, 1, 'COMMA', 2, 'POINT')} : '—'">25,000.00</dd>
                <dt>Charges this month</dt>
                <dd>
                    <span th:text="${#numbers.formatDecimal(runningTotal, 1, 'COMMA', 2, 'POINT')}">0.00</span>
                    <span class="sub" th:if="${billFrom != null and billTo != null}"
                          th:text="' (' + ${#temporals.format(billFrom, 'dd MMM')} + ' – ' + ${#temporals.format(billTo, 'dd MMM')} + ')'"> (01 Sep – 12 Sep)</span>
                </dd>
                <dt>Start date</dt>
                <dd th:text="${customer.serviceStartDate != null} ? ${#temporals.format(customer.serviceStartDate, 'dd MMM yyyy')} : '—' ">—</dd>
                <dt>Status</dt>
                <dd th:text="${customer.status}">NEW</dd>
                <dt>Medical history</dt>
                <dd th:text="${customer.medicalHistory != null} ? ${customer.medicalHistory} : '—'">—</dd>
            </dl>
        </div>
        <div class="panel">
            <h3>Assign to customer location</h3>
            <div th:if="${customer.assignedEmployee != null}" style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
                <p style="margin:0;">
                    Current staff:
                    <a th:href="@{/employees/{id}(id=${customer.assignedEmployee.id})}"
                       th:text="${customer.assignedEmployee.empCode} + ' · ' + ${customer.assignedEmployee.fullName}">EMP</a>
                </p>
                <form th:if="${canWriteCustomers and !customer.closed}" th:action="@{/customers/{id}/assign(id=${customer.id})}" method="post" style="margin:0;">
                    <input type="hidden" name="employeeId" value=""/>
                    <button class="btn ghost" type="submit">Release employee</button>
                </form>
            </div>
            <p th:unless="${customer.assignedEmployee != null}" class="sub">No caregiver assigned yet.</p>
            <form th:if="${canWriteCustomers and !customer.closed}" th:action="@{/customers/{id}/assign(id=${customer.id})}" method="post" style="margin-top:12px">
                <label>Employee</label>
                <select name="employeeId">
                    <option value="">Unassigned</option>
                    <option th:each="e : ${staff}" th:value="${e.id}" th:text="${e.empCode} + ' · ' + ${e.fullName}"
                            th:selected="${customer.assignedEmployee != null and customer.assignedEmployee.id == e.id}">EMP</option>
                </select>
                <div class="actions" style="margin-top:12px">
                    <button class="btn" type="submit">Save assignment</button>
                    <button type="button" class="btn secondary" th:if="${customer.assignedEmployee != null}"
                            th:attr="data-brochure-url=@{/employees/{id}/brochure(id=${customer.assignedEmployee.id})}">Share staff brochure</button>
                </div>
            </form>
        </div>
    </div>

    <div class="panel" id="invoice-panel" th:attr="data-base-total=${runningTotal != null ? runningTotal.doubleValue() : 0.0}, data-service-days=${serviceDays != null ? serviceDays : 0}, data-customer-id=${customer.id}">
        <div class="topbar" style="margin-bottom:12px; align-items:flex-end;">
            <div>
                <p class="eyebrow">Billing</p>
                <h3 style="margin:0">VNS Healthcare Invoice</h3>
            </div>
            <div class="actions" style="gap:8px;">
                <button type="button" class="btn secondary" id="save-invoice-btn">Save invoice</button>
                <button type="button" class="btn ghost" id="share-invoice-btn">Share invoice</button>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:12px; margin-bottom:12px;">
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Select account</label>
                <select id="invoice-account-select" style="width:100%;" th:if="${!#lists.isEmpty(bankAccounts)}">
                    <option value="">Select account</option>
                    <option th:each="account : ${bankAccounts}"
                            th:value="${account.id}"
                            th:text="${account.accountName + ' · ' + account.bankName + ' · ' + account.accountNo}"
                            th:attr="data-account-name=${account.accountName}, data-bank-name=${account.bankName}, data-account-no=${account.accountNo}, data-ifsc-code=${account.ifscCode}, data-gpay-phonepe=${account.gpayPhonepe}">Account</option>
                </select>
                <p class="sub" th:if="${#lists.isEmpty(bankAccounts)}">No bank accounts available.</p>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:12px;">
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Patient</label>
                <div style="font-size:1.02rem; font-weight:600;" th:text="${customer.patientName}">Patient</div>
            </div>
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Customer code</label>
                <div style="font-size:1.02rem; font-weight:600;" th:text="${customer.custCode}">CUS-1001</div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end; margin-bottom:12px;">
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Service days</label>
                <div id="invoice-service-days" style="font-size:1.2rem; font-weight:700; color:var(--ink);" th:text="${serviceDays}">0</div>
            </div>
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Per day service</label>
                <div id="invoice-daily-rate" style="font-size:1.2rem; font-weight:700; color:var(--ink);"
                     th:text="${invoiceDailyRate != null} ? ${#numbers.formatDecimal(invoiceDailyRate, 1, 'COMMA', 2, 'POINT')} : '0.00'">0.00</div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:12px;">
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">From date</label>
                <input id="invoice-date-from" type="date" style="width:100%;"/>
            </div>
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">To date</label>
                <input id="invoice-date-to" type="date" style="width:100%;"/>
            </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin:10px 0 8px; flex-wrap:wrap;">
            <h4 style="margin:0; font-size:1rem;">Total charges</h4>
            <button type="button" id="add-invoice-row-btn" class="btn secondary small">Add row</button>
        </div>

        <div style="overflow-x:auto; margin-bottom:12px;">
            <table style="width:100%; border-collapse:collapse; min-width:620px;">
                <thead>
                <tr>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:center; width:60px;">Sr. No</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:left;">Description</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:right; width:180px;">Amount (Rs.)</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:center; width:90px;">Action</th>
                </tr>
                </thead>
                <tbody id="invoice-breakdown-body"></tbody>
            </table>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end; margin-bottom:12px;">
            <div>
                <label style="display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-bottom:6px;">Total charges</label>
                <div id="invoice-total-raw" style="font-size:1.2rem; font-weight:700; color:var(--ink);">₹0.00</div>
            </div>
            <div>
                <label style="display:flex; align-items:center; gap:8px; margin-bottom:8px; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted);">
                    <input type="checkbox" id="apply-discount"/>
                    Apply discount
                </label>
                <div style="display:flex; align-items:center; gap:8px;">
                    <input id="invoice-discount" type="number" min="0" step="0.01" value="0" disabled style="max-width:150px;" placeholder="0.00"/>
                    <span class="sub">₹</span>
                </div>
            </div>
        </div>

        <hr style="margin:12px 0; border-color: var(--line);"/>

        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
            <label style="font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin:0;">Net amount</label>
            <strong id="invoice-net-amount" style="font-size:1.4rem; color:var(--teal);">₹0.00</strong>
        </div>

        <div style="margin-top:18px; padding-top:14px; border-top:1px solid var(--line);">
            <h4 style="margin:0 0 10px;">Invoice history</h4>
            <table th:if="${!#lists.isEmpty(customerInvoices)}" style="width:100%; border-collapse:collapse;">
                <thead>
                <tr>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:left;">Period</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:left;">Invoice</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:right;">Total</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:right;">Discount</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:right;">Net</th>
                    <th style="padding:8px 10px; border:1px solid var(--line); text-align:center; width:150px;">Action</th>
                </tr>
                </thead>
                <tbody id="customer-invoice-history-body">
                <tr th:each="invoice : ${customerInvoices}" th:attr="data-invoice-id=${invoice.id}">
                    <td style="padding:8px 10px; border:1px solid var(--line);"
                        th:text="${#temporals.format(invoice.fromDate, 'dd MMM yyyy')} + ' - ' + ${#temporals.format(invoice.toDate, 'dd MMM yyyy')}">01 Aug - 31 Aug</td>
                    <td style="padding:8px 10px; border:1px solid var(--line);" th:text="${invoice.invoiceNumber}">INV-1001</td>
                    <td style="padding:8px 10px; border:1px solid var(--line); text-align:right;" th:text="${#numbers.formatDecimal(invoice.totalAmount, 1, 'COMMA', 2, 'POINT')}">0.00</td>
                    <td style="padding:8px 10px; border:1px solid var(--line); text-align:right;" th:text="${#numbers.formatDecimal(invoice.discountAmount, 1, 'COMMA', 2, 'POINT')}">0.00</td>
                    <td style="padding:8px 10px; border:1px solid var(--line); text-align:right;" th:text="${#numbers.formatDecimal(invoice.netAmount, 1, 'COMMA', 2, 'POINT')}">0.00</td>
                    <td style="padding:8px 10px; border:1px solid var(--line); text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">
                            <button type="button" class="btn ghost small view-invoice-btn" th:attr="data-invoice-id=${invoice.id}">View</button>
                            <button type="button" class="btn ghost small delete-invoice-btn" th:attr="data-invoice-id=${invoice.id}">Delete</button>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
            <p class="sub" th:if="${#lists.isEmpty(customerInvoices)}">No invoice saved for this customer yet.</p>
        </div>
    </div>

    <div class="panel">
        <h3>Duty roster (date range)</h3>
        <p class="sub">Example: Day-01 to Day-04 Employee A, then Day-05 to Day-10 Employee B. Tick Hold for unpaid days.</p>
        <form th:if="${canWriteCustomers and !customer.closed}" th:action="@{/customers/{id}/duties(id=${customer.id})}" method="post" class="form-grid">
            <div class="field">
                <label class="req">From</label>
                <input type="date" name="from" required="required"/>
            </div>
            <div class="field">
                <label class="req">To</label>
                <input type="date" name="to" required="required"/>
            </div>
            <div class="field">
                <label>Employee</label>
                <select name="employeeId">
                    <option value="">Select</option>
                    <option th:each="e : ${staff}" th:value="${e.id}" th:text="${e.empCode} + ' · ' + ${e.fullName}">EMP</option>
                </select>
            </div>
            <div class="field">
                <label>Hold (no charges)</label>
                <label style="text-transform:none;letter-spacing:0;font-size:14px">
                    <input type="checkbox" name="hold" value="true"/> Mark these days as Hold
                </label>
            </div>
            <div class="field">
                <button class="btn" type="submit">Save range</button>
            </div>
        </form>
        <p class="sub" th:if="${customer.closed}">Duty dates cannot be changed after close.</p>
    </div>

    <div class="panel">
        <div class="topbar" style="margin-bottom:12px">
            <h3 style="margin:0" th:text="'Days in ' + ${month}">Days</h3>
            <form method="get" th:action="@{/customers/{id}(id=${customer.id})}" class="search" style="margin:0">
                <input type="month" name="month" th:value="${month}"/>
                <button class="btn ghost" type="submit">Show month</button>
            </form>
        </div>
        <table>
            <thead>
            <tr>
                <th>Date</th>
                <th>Staff / Hold</th>
            </tr>
            </thead>
            <tbody>
            <tr th:each="row : ${dayRows}">
                <td th:text="${#temporals.format(row.date, 'dd MMM yyyy')}">01 Sep</td>
                <td>
                    <span class="badge warn" th:if="${row.hold}">Hold</span>
                    <span th:if="${row.hasStaff()}" th:text="${row.staffName}">Name</span>
                    <span class="badge muted" th:if="${row.empty}">—</span>
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h3>Documents</h3>
        <form th:if="${canWriteCustomers}" th:action="@{/customers/{id}/documents(id=${customer.id})}" method="post" enctype="multipart/form-data" class="search">
            <input th:if="${_csrf != null}" type="hidden" name="_csrf" th:value="${_csrf.token}"/>
            <input type="file" name="documents" multiple/>
            <button class="btn secondary" type="submit">Upload</button>
        </form>
        <table th:if="${!customer.documents.isEmpty()}">
            <thead>
            <tr><th>File</th><th>Size</th><th>Uploaded</th><th></th></tr>
            </thead>
            <tbody>
            <tr th:each="d : ${customer.documents}">
                <td th:text="${d.originalFilename}">file.pdf</td>
                <td th:text="${d.fileSize}">0</td>
                <td th:text="${#temporals.format(d.uploadedAt, 'dd MMM yyyy HH:mm')}">01 Jan</td>
                <td style="display:flex; gap:8px; align-items:center">
                    <a href="#" th:attr="data-preview-url=@{/customers/{id}/documents/{docId}(id=${customer.id}, docId=${d.id})}" class="btn ghost small">View</a>
                    <form th:if="${canWriteCustomers}" th:action="@{/customers/{id}/documents/{docId}/delete(id=${customer.id}, docId=${d.id})}" method="post" style="margin:0">
                        <input th:if="${_csrf != null}" type="hidden" name="_csrf" th:value="${_csrf.token}"/>
                        <button class="btn ghost small" type="submit" data-confirm-delete="true" data-confirm-text="Delete this document?">Delete</button>
                    </form>
                </td>
            </tr>
            </tbody>
        </table>
        <p class="empty" th:if="${customer.documents.isEmpty()}">No documents uploaded.</p>
    </div>

    <div id="invoice-modal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.52); z-index:2000; align-items:center; justify-content:center; padding:24px;">
        <div style="width:min(92vw, 760px); background:#fff; border-radius:16px; box-shadow:0 20px 60px rgba(15,23,42,0.24); overflow:hidden; border:1px solid #e5e7eb;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; border-bottom:1px solid #e5e7eb; background:#f8fafc;">
                <strong style="font-size:1.1rem;">Invoice Preview</strong>
                <button type="button" id="close-invoice-modal" class="btn ghost small">Close</button>
            </div>
            <div style="padding:18px; background:#fff;">
                <div id="invoice-preview-area" style="min-height:520px; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;"></div>
                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:16px;">
                    <button type="button" id="print-invoice-btn" class="btn">Print / Save as PDF</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var panel = document.getElementById('invoice-panel');
            if (!panel) {
                return;
            }

            var baseTotal = Number(panel.dataset.baseTotal || 0);
            var serviceDays = Number(panel.dataset.serviceDays || 0);
            var checkbox = document.getElementById('apply-discount');
            var discountInput = document.getElementById('invoice-discount');
            var netAmount = document.getElementById('invoice-net-amount');
            var totalCharges = document.getElementById('invoice-total-raw');
            var dailyRateEl = document.getElementById('invoice-daily-rate');
            var shareBtn = document.getElementById('share-invoice-btn');
            var saveBtn = document.getElementById('save-invoice-btn');
            var accountSelect = document.getElementById('invoice-account-select');
            var modal = document.getElementById('invoice-modal');
            var previewArea = document.getElementById('invoice-preview-area');
            var closeModalBtn = document.getElementById('close-invoice-modal');
            var printBtn = document.getElementById('print-invoice-btn');
            var addRowBtn = document.getElementById('add-invoice-row-btn');
            var invoiceDateFrom = document.getElementById('invoice-date-from');
            var customerId = panel.dataset.customerId;
            var invoiceDateTo = document.getElementById('invoice-date-to');
            var invoiceTableBody = document.getElementById('invoice-breakdown-body');
            var formatter = new Intl.NumberFormat('en-IN', {
                style: 'currency',
                currency: 'INR',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            function showVnsFlash(message, type) {
                if (!message || !document.body) {
                    return;
                }
                var flash = document.createElement('div');
                flash.className = 'flash' + (type === 'error' ? ' error' : '');
                flash.textContent = message;
                flash.setAttribute('role', 'status');
                flash.setAttribute('aria-live', 'polite');
                document.body.appendChild(flash);
                setTimeout(function () {
                    flash.classList.add('flash-hidden');
                }, 2200);
                setTimeout(function () {
                    if (flash.parentNode) {
                        flash.parentNode.removeChild(flash);
                    }
                }, 2600);
            }

            function formatInputDate(date) {
                var year = date.getFullYear();
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                return year + '-' + month + '-' + day;
            }

            function setDefaultInvoiceDates() {
                if (!invoiceDateFrom || !invoiceDateTo) {
                    return;
                }
                var today = new Date();
                var firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                invoiceDateFrom.value = formatInputDate(firstDayOfMonth);
                invoiceDateTo.value = formatInputDate(today);
            }

            var dailyRate = serviceDays > 0 ? (baseTotal / serviceDays) : 0;
            if (dailyRateEl) {
                dailyRateEl.textContent = formatter.format(dailyRate);
            }

            function formatDisplayDate(dateValue) {
                if (!dateValue) {
                    return '';
                }
                var parsed = new Date(dateValue + 'T00:00:00');
                if (Number.isNaN(parsed.getTime())) {
                    return dateValue;
                }
                return String(parsed.getDate()).padStart(2, '0') + '.' + String(parsed.getMonth() + 1).padStart(2, '0') + '.' + parsed.getFullYear();
            }

            function buildDateRangeDescription() {
                var fromText = invoiceDateFrom ? formatDisplayDate(invoiceDateFrom.value) : '';
                var toText = invoiceDateTo ? formatDisplayDate(invoiceDateTo.value) : '';
                if (fromText && toText) {
                    return 'Charges of Home Nursing Services for the Period of ' + fromText + ' TO ' + toText;
                }
                return 'Charges of Home Nursing Services';
            }

            function buildRowDateText() {
                var fromText = invoiceDateFrom ? invoiceDateFrom.value : '';
                var toText = invoiceDateTo ? invoiceDateTo.value : '';
                if (!fromText && !toText) {
                    return '';
                }
                if (fromText && toText && fromText === toText) {
                    return formatDateDisplayForRow(fromText);
                }
                if (fromText && toText) {
                    return formatDateDisplayForRow(fromText) + ' to ' + formatDateDisplayForRow(toText);
                }
                return fromText ? formatDateDisplayForRow(fromText) : formatDateDisplayForRow(toText);
            }

            function formatDateDisplayForRow(dateValue) {
                if (!dateValue) {
                    return '';
                }
                var parsed = new Date(dateValue + 'T00:00:00');
                if (Number.isNaN(parsed.getTime())) {
                    return dateValue;
                }
                return String(parsed.getDate()).padStart(2, '0') + '-' + String(parsed.getMonth() + 1).padStart(2, '0') + '-' + parsed.getFullYear();
            }

            var lastFocusedInvoiceRow = null;

            function getDateTargetRow() {
                if (lastFocusedInvoiceRow && invoiceTableBody && invoiceTableBody.contains(lastFocusedInvoiceRow)) {
                    return lastFocusedInvoiceRow;
                }
                var autoRows = Array.prototype.slice.call(invoiceTableBody ? invoiceTableBody.querySelectorAll('tr') : []).filter(function (row) {
                    return row.dataset.autoDescription === 'true';
                });
                return autoRows.length > 0 ? autoRows[autoRows.length - 1] : null;
            }

            function applyDateToFocusedRow() {
                if (!invoiceDateFrom && !invoiceDateTo) {
                    return;
                }
                var row = getDateTargetRow();
                if (!row || !invoiceTableBody || !invoiceTableBody.contains(row)) {
                    return;
                }
                var descriptionInput = row.querySelector('.invoice-item-description');
                if (!descriptionInput) {
                    return;
                }
                var dateText = buildRowDateText();
                if (!dateText) {
                    return;
                }
                var currentText = (descriptionInput.value || '').trim();
                if (row.dataset.autoDescription === 'true') {
                    descriptionInput.value = buildDateRangeDescription();
                    return;
                }
                var baseText = currentText.replace(/\s*\d{2}-\d{2}-\d{4}(?:\s*to\s*\d{2}-\d{2}-\d{4})?\s*$/, '').trim();
                descriptionInput.value = (baseText || 'Charges of Home Nursing Services') + ' ' + dateText;
            }

            function currentDiscountValue() {
                var checked = checkbox && checkbox.checked;
                var discountValue = checked && discountInput ? parseFloat(discountInput.value || '0') : 0;
                if (!Number.isFinite(discountValue)) {
                    discountValue = 0;
                }
                return Math.max(0, discountValue);
            }

            function readInvoiceRows() {
                if (!invoiceTableBody) {
                    return [];
                }
                return Array.prototype.slice.call(invoiceTableBody.querySelectorAll('tr')).map(function (row) {
                    var descriptionInput = row.querySelector('.invoice-item-description');
                    var amountInput = row.querySelector('.invoice-item-amount');
                    var description = descriptionInput ? (descriptionInput.value || '').trim() : '';
                    var amount = parseFloat(amountInput ? (amountInput.value || '0') : '0');
                    return {
                        description: description,
                        amount: Number.isFinite(amount) ? Math.max(0, amount) : 0
                    };
                }).filter(function (row) {
                    return row.description || row.amount > 0;
                });
            }

            function refreshInvoiceRowNumbers() {
                if (!invoiceTableBody) {
                    return;
                }
                Array.prototype.slice.call(invoiceTableBody.querySelectorAll('tr')).forEach(function (row, index) {
                    var srCell = row.querySelector('td:first-child');
                    if (srCell) {
                        srCell.textContent = index + 1;
                    }
                });
            }

            function addInvoiceRow(description, amount, autoDescription) {
                if (!invoiceTableBody) {
                    return;
                }
                var rows = Array.prototype.slice.call(invoiceTableBody.querySelectorAll('tr'));
                if (autoDescription) {
                    rows.forEach(function (existingRow) {
                        if (existingRow.dataset.autoDescription === 'true') {
                            existingRow.dataset.autoDescription = 'false';
                            var existingInput = existingRow.querySelector('.invoice-item-description');
                            if (existingInput) {
                                existingInput.value = existingInput.value || buildDateRangeDescription();
                            }
                        }
                    });
                }
                var row = document.createElement('tr');
                var index = invoiceTableBody.querySelectorAll('tr').length + 1;
                var dateText = buildRowDateText();
                var resolvedDescription = autoDescription ? (dateText ? 'Charges of Home Nursing Services for the Period of ' + dateText : buildDateRangeDescription()) : (description || '');
                row.innerHTML = '<td style="padding:8px 10px; border:1px solid var(--line); text-align:center;">' + index + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line);"><input type="text" class="invoice-item-description" value="' + resolvedDescription.replace(/"/g, '&quot;') + '" style="width:100%; min-width:240px;" /></td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:right;"><input type="number" min="0" step="0.01" class="invoice-item-amount" value="' + (amount || 0) + '" style="width:100%; text-align:right;" /></td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:center;"><button type="button" class="btn ghost small remove-invoice-row">Remove</button></td>';
                row.dataset.autoDescription = autoDescription ? 'true' : 'false';
                var descriptionInput = row.querySelector('.invoice-item-description');
                var amountInput = row.querySelector('.invoice-item-amount');
                var removeBtn = row.querySelector('.remove-invoice-row');
                if (descriptionInput) {
                    descriptionInput.addEventListener('focus', function () {
                        lastFocusedInvoiceRow = row;
                    });
                    descriptionInput.addEventListener('input', function () {
                        row.dataset.autoDescription = 'false';
                        lastFocusedInvoiceRow = row;
                        updateInvoice();
                    });
                    if (autoDescription) {
                        descriptionInput.focus();
                    }
                }
                if (amountInput) {
                    amountInput.addEventListener('input', updateInvoice);
                }
                if (removeBtn) {
                    removeBtn.addEventListener('click', function () {
                        row.remove();
                        refreshInvoiceRowNumbers();
                        updateInvoice();
                    });
                }
                invoiceTableBody.appendChild(row);
                updateInvoice();
            }

            function populateDefaultInvoiceRows() {
                if (!invoiceTableBody) {
                    return;
                }
                invoiceTableBody.innerHTML = '';
                addInvoiceRow('', baseTotal, true);
            }

            function updateAutoDescriptions() {
                if (!invoiceTableBody) {
                    return;
                }
                var targetRow = getDateTargetRow();
                if (!targetRow) {
                    return;
                }
                var descriptionInput = targetRow.querySelector('.invoice-item-description');
                if (!descriptionInput) {
                    return;
                }
                if (targetRow.dataset.autoDescription === 'true') {
                    descriptionInput.value = buildDateRangeDescription();
                    return;
                }
                var dateText = buildRowDateText();
                if (!dateText) {
                    return;
                }
                var baseText = (descriptionInput.value || '').replace(/\s*\d{2}-\d{2}-\d{4}(?:\s*to\s*\d{2}-\d{2}-\d{4})?\s*$/, '').trim();
                descriptionInput.value = (baseText || 'Charges of Home Nursing Services') + ' ' + dateText;
            }

            function updateInvoiceTotal() {
                var rows = readInvoiceRows();
                var total = rows.reduce(function (sum, row) {
                    return sum + row.amount;
                }, 0);
                if (totalCharges) {
                    totalCharges.textContent = formatter.format(total);
                }
                if (netAmount) {
                    netAmount.textContent = formatter.format(Math.max(0, total - currentDiscountValue()));
                }
            }

            function updateInvoice() {
                var checked = checkbox && checkbox.checked;
                if (discountInput) {
                    discountInput.disabled = !checked;
                    if (!checked) {
                        discountInput.value = '0';
                    }
                }
                updateInvoiceTotal();
            }

            function getSelectedAccountDetails() {
                var account = null;
                if (accountSelect && accountSelect.value) {
                    var selectedOption = accountSelect.options[accountSelect.selectedIndex];
                    if (selectedOption && selectedOption.dataset.accountName) {
                        account = {
                            accountName: selectedOption.dataset.accountName || '',
                            bankName: selectedOption.dataset.bankName || '',
                            accountNo: selectedOption.dataset.accountNo || '',
                            ifscCode: selectedOption.dataset.ifscCode || '',
                            gpayPhonepe: selectedOption.dataset.gpayPhonepe || ''
                        };
                    }
                }
                return account;
            }

            function buildBreakdownTableMarkup() {
                var rows = readInvoiceRows();
                var total = rows.reduce(function (sum, row) {
                    return sum + row.amount;
                }, 0);
                var discountValue = currentDiscountValue();
                var html = '<table style="width:100%; border-collapse:collapse; margin-top:18px; font-family:Arial,sans-serif;">' +
                    '<thead><tr><th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:center; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">No.</th>' +
                    '<th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">Description</th>' +
                    '<th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">Amount (Rs.)</th></tr></thead><tbody>';
                rows.forEach(function (row, index) {
                    html += '<tr><td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:center;">' + (index + 1) + '</td>' +
                        '<td style="padding:10px 8px; border:1px solid #e5e7eb;">' + (row.description || '—') + '</td>' +
                        '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right;">' + formatter.format(row.amount) + '</td></tr>';
                });
                html += '<tr><td colspan="2" style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">Total Charges</td>' +
                    '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">' + formatter.format(total) + '</td></tr>';
                if (checkbox && checkbox.checked) {
                    html += '<tr><td colspan="2" style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">Discount</td>' +
                        '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">' + formatter.format(discountValue) + '</td></tr>';
                }
                html += '</tbody></table>';
                return html;
            }

            function buildInvoiceHtml() {
                var patient = document.querySelector('#invoice-panel [style*="font-size:1.02rem; font-weight:600;"]');
                var customerCode = document.querySelectorAll('#invoice-panel [style*="font-size:1.02rem; font-weight:600;"]')[1];
                var serviceValue = document.getElementById('invoice-service-days');
                var rateValue = document.getElementById('invoice-daily-rate');
                var discountValue = currentDiscountValue();
                var rows = readInvoiceRows();
                var total = rows.reduce(function (sum, row) {
                    return sum + row.amount;
                }, 0);
                var finalAmount = Math.max(0, total - discountValue);
                var patientName = patient ? patient.textContent.trim() : 'N/A';
                var customerText = customerCode ? customerCode.textContent.trim() : 'N/A';
                var selectedAccount = getSelectedAccountDetails();
                var accountLines = selectedAccount ?
                    '<div class="account-box">' +
                    '<div class="label">Bank account details</div>' +
                    '<div class="value" style="font-size:14px; line-height:1.8; margin-top:8px;">' +
                    'Account Name: ' + (selectedAccount.accountName || '—') + '<br/>' +
                    'Bank Name: ' + (selectedAccount.bankName || '—') + '<br/>' +
                    'Account no.: ' + (selectedAccount.accountNo || '—') + '<br/>' +
                    'IFSC code: ' + (selectedAccount.ifscCode || '—') + '<br/>' +
                    'GPay/phonepay: ' + (selectedAccount.gpayPhonepe || '—') +
                    '</div></div>' :
                    '<div class="account-box"><div class="label">Bank account</div><div class="value" style="font-size:15px;">Not selected</div></div>';
                return '<!doctype html>' +
                    '<html><head><meta charset="UTF-8"><title>VNS Healthcare Invoice</title>' +
                    '<style>' +
                    'body{font-family:Arial,sans-serif;padding:28px;background:#fff;color:#111827;margin:0;} ' +
                    '.card{max-width:720px;margin:0 auto;border:1px solid #e5e7eb;border-radius:12px;padding:26px;background:#fff;box-shadow:0 14px 32px rgba(16,60,55,0.08);} ' +
                    '.brand-row{display:flex;align-items:center;justify-content:center;gap:14px;padding-bottom:14px;margin-bottom:18px;border-bottom:1px solid #e5e7eb;text-align:center;} ' +
                    '.mark{width:48px;height:48px;border:1px solid #d7c28a;background:linear-gradient(135deg,#1b5c54,#0e3832);display:grid;place-items:center;font-family:Georgia,serif;font-weight:700;font-size:22px;color:#f0e2b8;letter-spacing:0.04em;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12);} ' +
                    '.brand-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;} ' +
                    '.brand-copy h1{margin:0; font-family:Georgia,serif;font-size:30px;font-weight:600;letter-spacing:0.02em;color:#d91f26;text-align:center;} ' +
                    '.brand-copy p{margin:3px 0 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#6b7280;text-align:center;} ' +
                    '.title{font-size:28px;font-weight:700;margin:0 0 10px;text-align:center;} ' +
                    '.subtitle{font-size:13px;color:#6b7280;margin-bottom:16px;} ' +
                    '.meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0;} ' +
                    '.label{font-size:12px;text-transform:uppercase;letter-spacing:0.08em;color:#6b7280;} ' +
                    '.value{font-size:16px;font-weight:600;margin-top:6px;} ' +
                    '.account-box{margin-top:18px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#f8fafc;} ' +
                    '.row{display:flex;justify-content:space-between;border-top:1px solid #e5e7eb;padding-top:12px;margin-top:14px;font-weight:600;} ' +
                    '.row.total{font-size:20px;color:#1b5c54;} ' +
                    '@media print { body { padding: 0; } .card { border: none; box-shadow: none; max-width:100%; } }' +
                    '</style></head>' +
                    '<body><div class="card"><div class="brand-row"><!--<div class="mark">V</div>--><div class="brand-copy"><h1><u>VNS Healthcare</u></h1><p>Home care desk</p><p>Office: Sr. No. 56/1, Shewanti colony, Near Chintamani Chowk, Chinchwad, Pune - 33</p></div></div>' +
                    '<div class="title">Invoice</div>' +
                    '<div class="subtitle">Generated on ' + new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) + '</div>' +
                    '<div class="meta"><div><div class="label">Patient</div><div class="value">' + patientName + '</div></div>' +
                    '<div><div class="label">Customer code</div><div class="value">' + customerText + '</div></div></div>' +
                    '<div class="meta"><div><div class="label">Service days</div><div class="value">' + (serviceValue ? serviceValue.textContent.trim() : '0') + '</div></div>' +
                    '<div><div class="label">Per day service</div><div class="value">' + (rateValue ? rateValue.textContent.trim() : formatter.format(dailyRate)) + '</div></div></div>' +
                    accountLines +
                    buildBreakdownTableMarkup() +
                    (checkbox && checkbox.checked ? '<div class="row"><span>Discount</span><span>' + formatter.format(discountValue) + '</span></div>' : '') +
                    '<div class="row total"><span>Net amount</span><span>' + formatter.format(finalAmount) + '</span></div></div></body></html>';
            }

            function openInvoicePreview() {
                if (!previewArea) {
                    return;
                }
                previewArea.innerHTML = '<iframe title="Invoice preview" style="width:100%; height:520px; border:0; background:#fff;" srcdoc="' + buildInvoiceHtml().replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '"></iframe>';
                if (modal) {
                    modal.style.display = 'flex';
                }
            }

            function printInvoice() {
                var printWindow = window.open('', '_blank', 'width=900,height=700');
                if (!printWindow) {
                    showVnsFlash('Please allow pop-ups to print the invoice.', 'error');
                    return;
                }
                printWindow.document.write(buildInvoiceHtml());
                printWindow.document.close();
                printWindow.focus();
                printWindow.print();
            }

            function appendInvoiceHistoryRow(record) {
                var historyBody = document.getElementById('customer-invoice-history-body');
                if (!historyBody) {
                    return;
                }
                var row = document.createElement('tr');
                var fromText = record.fromDate ? record.fromDate : '';
                var toText = record.toDate ? record.toDate : '';
                row.dataset.invoiceId = record.invoiceId || '';
                row.innerHTML = '<td style="padding:8px 10px; border:1px solid var(--line);">' + fromText + ' - ' + toText + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line);">' + record.invoiceNumber + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:right;">' + formatter.format(record.totalAmount || 0) + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:right;">' + formatter.format(record.discountAmount || 0) + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:right;">' + formatter.format(record.netAmount || 0) + '</td>' +
                    '<td style="padding:8px 10px; border:1px solid var(--line); text-align:center;">' +
                    '<div style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">' +
                    '<button type="button" class="btn ghost small view-invoice-btn" data-invoice-id="' + (record.invoiceId || '') + '">View</button>' +
                    '<button type="button" class="btn ghost small delete-invoice-btn" data-invoice-id="' + (record.invoiceId || '') + '">Delete</button>' +
                    '</div></td>';
                historyBody.insertBefore(row, historyBody.firstChild);
                bindInvoiceHistoryActions(row);
            }

            function getInvoiceActionHeaders() {
                var csrfMeta = document.querySelector('meta[name="_csrf"]');
                var csrfHeaderMeta = document.querySelector('meta[name="_csrf_header"]');
                var headers = { 'Content-Type': 'application/json' };
                if (csrfMeta && csrfHeaderMeta) {
                    headers[csrfHeaderMeta.getAttribute('content')] = csrfMeta.getAttribute('content');
                }
                return headers;
            }

            function askDeleteInvoice(invoiceId, button) {
                var confirmText = document.getElementById('confirm-text');
                var confirmYes = document.getElementById('confirm-yes');
                var confirmNo = document.getElementById('confirm-no');
                if (!confirmText || !confirmYes || !confirmNo) {
                    if (window.confirm('Delete this invoice record?')) {
                        deleteInvoiceRecord(invoiceId, button);
                    }
                    return;
                }
                confirmText.textContent = 'Delete this invoice record?';
                confirmYes.onclick = function () {
                    toggleModal('confirm-modal', false);
                    deleteInvoiceRecord(invoiceId, button);
                };
                confirmNo.onclick = function () {
                    toggleModal('confirm-modal', false);
                };
                toggleModal('confirm-modal', true);
            }

            function deleteInvoiceRecord(invoiceId, button) {
                fetch('/customers/' + customerId + '/invoices/' + invoiceId, {
                    method: 'DELETE',
                    credentials: 'same-origin',
                    headers: getInvoiceActionHeaders()
                }).then(function (response) {
                    return response.json().then(function (data) {
                        if (!response.ok || data.success === false) {
                            throw new Error(data.message || 'Could not delete invoice.');
                        }
                        return data;
                    });
                }).then(function () {
                    var row = button && button.closest ? button.closest('tr') : null;
                    if (row && row.parentNode) {
                        row.parentNode.removeChild(row);
                    }
                    showVnsFlash('Invoice deleted successfully.', 'success');
                }).catch(function (error) {
                    showVnsFlash(error.message || 'Could not delete invoice.', 'error');
                });
            }

            function bindInvoiceHistoryActions(container) {
                var rows = container && container.querySelectorAll ? container.querySelectorAll('.view-invoice-btn, .delete-invoice-btn') : document.querySelectorAll('.view-invoice-btn, .delete-invoice-btn');
                if (!rows) {
                    return;
                }
                rows.forEach(function (button) {
                    button.onclick = null;
                    button.addEventListener('click', function () {
                        var invoiceId = button.getAttribute('data-invoice-id');
                        if (!invoiceId) {
                            return;
                        }
                        if (button.classList.contains('view-invoice-btn')) {
                            fetch('/customers/' + customerId + '/invoices/' + invoiceId, {
                                method: 'GET',
                                credentials: 'same-origin'
                            }).then(function (response) {
                                return response.json().then(function (data) {
                                    if (!response.ok || data.success === false) {
                                        throw new Error(data.message || 'Could not load invoice.');
                                    }
                                    return data;
                                });
                            }).then(function (invoice) {
                                renderSavedInvoicePreview(invoice);
                            }).catch(function (error) {
                                showVnsFlash(error.message || 'Could not load invoice.', 'error');
                            });
                            return;
                        }
                        if (button.classList.contains('delete-invoice-btn')) {
                            askDeleteInvoice(invoiceId, button);
                        }
                    });
                });
            }

            function renderSavedInvoicePreview(invoice) {
                var patient = document.querySelector('#invoice-panel [style*="font-size:1.02rem; font-weight:600;"]');
                var customerCode = document.querySelectorAll('#invoice-panel [style*="font-size:1.02rem; font-weight:600;"]')[1];
                var patientName = patient ? patient.textContent.trim() : 'N/A';
                var customerText = customerCode ? customerCode.textContent.trim() : 'N/A';
                var rows = Array.isArray(invoice && invoice.rows) ? invoice.rows : [];
                var total = Number(invoice && invoice.totalAmount ? invoice.totalAmount : 0);
                var discount = Number(invoice && invoice.discountAmount ? invoice.discountAmount : 0);
                var finalAmount = Number(invoice && invoice.netAmount ? invoice.netAmount : Math.max(0, total - discount));
                var selectedAccount = {
                    accountName: invoice && invoice.bankAccountName ? invoice.bankAccountName : '',
                    bankName: '',
                    accountNo: invoice && invoice.bankAccountNo ? invoice.bankAccountNo : '',
                    ifscCode: invoice && invoice.ifscCode ? invoice.ifscCode : '',
                    gpayPhonepe: invoice && invoice.gpayPhonepe ? invoice.gpayPhonepe : ''
                };
                var accountLines = '<div class="account-box"><div class="label">Bank account details</div><div class="value" style="font-size:14px; line-height:1.8; margin-top:8px;">' +
                    'Account Name: ' + (selectedAccount.accountName || '—') + '<br/>' +
                    'Bank Name: ' + (selectedAccount.bankName || '—') + '<br/>' +
                    'Account no.: ' + (selectedAccount.accountNo || '—') + '<br/>' +
                    'IFSC code: ' + (selectedAccount.ifscCode || '—') + '<br/>' +
                    'GPay/phonepay: ' + (selectedAccount.gpayPhonepe || '—') +
                    '</div></div>';
                var html = '<!doctype html>' +
                    '<html><head><meta charset="UTF-8"><title>VNS Healthcare Invoice</title>' +
                    '<style>' +
                    'body{font-family:Arial,sans-serif;padding:28px;background:#fff;color:#111827;margin:0;} ' +
                    '.card{max-width:720px;margin:0 auto;border:1px solid #e5e7eb;border-radius:12px;padding:26px;background:#fff;box-shadow:0 14px 32px rgba(16,60,55,0.08);} ' +
                    '.brand-row{display:flex;align-items:center;justify-content:center;gap:14px;padding-bottom:14px;margin-bottom:18px;border-bottom:1px solid #e5e7eb;text-align:center;} ' +
                    '.mark{width:48px;height:48px;border:1px solid #d7c28a;background:linear-gradient(135deg,#1b5c54,#0e3832);display:grid;place-items:center;font-family:Georgia,serif;font-weight:700;font-size:22px;color:#f0e2b8;letter-spacing:0.04em;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12);} ' +
                    '.brand-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;} ' +
                    '.brand-copy h1{margin:0; font-family:Georgia,serif;font-size:30px;font-weight:600;letter-spacing:0.02em;color:#d91f26;text-align:center;} ' +
                    '.brand-copy p{margin:3px 0 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#6b7280;text-align:center;} ' +
                    '.title{font-size:28px;font-weight:700;margin:0 0 10px;text-align:center;} ' +
                    '.subtitle{font-size:13px;color:#6b7280;margin-bottom:16px;} ' +
                    '.meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0;} ' +
                    '.label{font-size:12px;text-transform:uppercase;letter-spacing:0.08em;color:#6b7280;} ' +
                    '.value{font-size:16px;font-weight:600;margin-top:6px;} ' +
                    '.account-box{margin-top:18px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#f8fafc;} ' +
                    '.row{display:flex;justify-content:space-between;border-top:1px solid #e5e7eb;padding-top:12px;margin-top:14px;font-weight:600;} ' +
                    '.row.total{font-size:20px;color:#1b5c54;} ' +
                    '@media print { body { padding: 0; } .card { border: none; box-shadow: none; max-width:100%; } }' +
                    '</style></head>' +
                    '<body><div class="card"><div class="brand-row"><div class="mark">V</div><div class="brand-copy"><h1>VNS Healthcare</h1><p>Home care desk</p><p>Office: Sr. No. 56/1, Shewanti colony, Near Chintamani Chowk, Chinchwad, Pune - 33</p></div></div>' +
                    '<div class="title">Invoice</div>' +
                    '<div class="subtitle">Generated on ' + new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) + '</div>' +
                    '<div class="meta"><div><div class="label">Patient</div><div class="value">' + patientName + '</div></div>' +
                    '<div><div class="label">Customer code</div><div class="value">' + customerText + '</div></div></div>' +
                    accountLines +
                    '<table style="width:100%; border-collapse:collapse; margin-top:18px; font-family:Arial,sans-serif;">' +
                    '<thead><tr><th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:center; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">No.</th>' +
                    '<th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">Description</th>' +
                    '<th style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280;">Amount (Rs.)</th></tr></thead><tbody>';
                rows.forEach(function (row, index) {
                    html += '<tr><td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:center;">' + (index + 1) + '</td>' +
                        '<td style="padding:10px 8px; border:1px solid #e5e7eb;">' + (row.description || '—') + '</td>' +
                        '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right;">' + formatter.format(Number(row.amount || 0)) + '</td></tr>';
                });
                html += '<tr><td colspan="2" style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">Total Charges</td>' +
                    '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">' + formatter.format(total) + '</td></tr>' +
                    (discount > 0 ? '<tr><td colspan="2" style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">Discount</td>' +
                    '<td style="padding:10px 8px; border:1px solid #e5e7eb; text-align:right; font-weight:700;">' + formatter.format(discount) + '</td></tr>' : '') +
                    '</tbody></table>' +
                    '<div class="row total"><span>Net amount</span><span>' + formatter.format(finalAmount) + '</span></div></div></body></html>';
                if (previewArea) {
                    previewArea.innerHTML = '<iframe title="Invoice preview" style="width:100%; height:520px; border:0; background:#fff;" srcdoc="' + html.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '"></iframe>';
                }
                if (modal) {
                    modal.style.display = 'flex';
                }
            }

            function saveInvoice() {
                if (!customerId) {
                    showVnsFlash('Customer id is missing.', 'error');
                    return;
                }
                if (accountSelect && !accountSelect.value) {
                    showVnsFlash('Please select a bank account before saving the invoice.', 'error');
                    accountSelect.focus();
                    return;
                }
                var rows = readInvoiceRows();
                var total = rows.reduce(function (sum, row) {
                    return sum + row.amount;
                }, 0);
                var discountValue = currentDiscountValue();
                var payload = {
                    fromDate: invoiceDateFrom ? invoiceDateFrom.value : '',
                    toDate: invoiceDateTo ? invoiceDateTo.value : '',
                    totalAmount: total,
                    discountAmount: discountValue,
                    netAmount: Math.max(0, total - discountValue),
                    rows: rows,
                    accountId: accountSelect ? accountSelect.value : '',
                    accountName: accountSelect && accountSelect.value ? (accountSelect.options[accountSelect.selectedIndex].dataset.accountName || '') : '',
                    accountNo: accountSelect && accountSelect.value ? (accountSelect.options[accountSelect.selectedIndex].dataset.accountNo || '') : '',
                    ifscCode: accountSelect && accountSelect.value ? (accountSelect.options[accountSelect.selectedIndex].dataset.ifscCode || '') : '',
                    gpayPhonepe: accountSelect && accountSelect.value ? (accountSelect.options[accountSelect.selectedIndex].dataset.gpayPhonepe || '') : '',
                    invoiceNumber: 'INV-' + customerId + '-' + Date.now()
                };

                var csrfMeta = document.querySelector('meta[name="_csrf"]');
                var csrfHeaderMeta = document.querySelector('meta[name="_csrf_header"]');
                var headers = { 'Content-Type': 'application/json' };
                if (csrfMeta && csrfHeaderMeta) {
                    headers[csrfHeaderMeta.getAttribute('content')] = csrfMeta.getAttribute('content');
                }

                fetch('/customers/' + customerId + '/invoices', {
                    method: 'POST',
                    headers: headers,
                    credentials: 'same-origin',
                    body: JSON.stringify(payload)
                }).then(function (response) {
                    return response.json().then(function (data) {
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Invoice could not be saved.');
                        }
                        return data;
                    });
                }).then(function (data) {
                    var invoiceRecord = {
                        invoiceId: data.invoiceId || '',
                        fromDate: payload.fromDate ? formatDisplayDate(payload.fromDate) : '',
                        toDate: payload.toDate ? formatDisplayDate(payload.toDate) : '',
                        invoiceNumber: data.invoiceNumber || payload.invoiceNumber,
                        totalAmount: payload.totalAmount || 0,
                        discountAmount: payload.discountAmount || 0,
                        netAmount: payload.netAmount || 0
                    };
                    appendInvoiceHistoryRow(invoiceRecord);
                    showVnsFlash('Invoice saved successfully.', 'success');
                }).catch(function (error) {
                    showVnsFlash(error.message || 'Invoice save failed.', 'error');
                });
            }

            setDefaultInvoiceDates();
            if (invoiceDateFrom) {
                invoiceDateFrom.addEventListener('change', function () {
                    updateAutoDescriptions();
                    applyDateToFocusedRow();
                    updateInvoice();
                });
            }
            if (invoiceDateTo) {
                invoiceDateTo.addEventListener('change', function () {
                    updateAutoDescriptions();
                    applyDateToFocusedRow();
                    updateInvoice();
                });
            }
            if (addRowBtn) {
                addRowBtn.addEventListener('click', function () {
                    addInvoiceRow('', 0, false);
                });
            }
            if (accountSelect) {
                var accountOptions = Array.prototype.slice.call(accountSelect.options).filter(function (option) {
                    return option.value;
                });
                if (accountOptions.length === 1) {
                    accountSelect.value = accountOptions[0].value;
                }
                accountSelect.addEventListener('change', function () {
                    var selected = accountSelect.options[accountSelect.selectedIndex];
                    if (!selected || !selected.value) {
                        return;
                    }
                    accountSelect.dataset.selectedAccountName = selected.dataset.accountName || '';
                    accountSelect.dataset.selectedBankName = selected.dataset.bankName || '';
                    accountSelect.dataset.selectedAccountNo = selected.dataset.accountNo || '';
                    accountSelect.dataset.selectedIfscCode = selected.dataset.ifscCode || '';
                    accountSelect.dataset.selectedGpayPhonepe = selected.dataset.gpayPhonepe || '';
                });
            }
            if (checkbox) {
                checkbox.addEventListener('change', updateInvoice);
            }
            if (discountInput) {
                discountInput.addEventListener('input', updateInvoice);
            }
            if (shareBtn) {
                shareBtn.addEventListener('click', function () {
                    if (accountSelect && !accountSelect.value) {
                        showVnsFlash('Please select a bank account before sharing the invoice.', 'error');
                        accountSelect.focus();
                        return;
                    }
                    openInvoicePreview();
                });
            }
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', function () { if (modal) { modal.style.display = 'none'; } });
            }
            if (printBtn) {
                printBtn.addEventListener('click', printInvoice);
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', saveInvoice);
            }
            bindInvoiceHistoryActions(document);
            populateDefaultInvoiceRows();
            updateInvoice();
        });
    </script>
</section>
</html>
